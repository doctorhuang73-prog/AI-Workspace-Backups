<Window x:Class="CDriveCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="C 盘空间管理工具" Width="560" Height="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="C 盘空间管理工具" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,20" Text="仅处理当前登录用户，所有操作均需确认。" Foreground="DimGray" />
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <Button Content="扫描 C 盘并清理" Click="Clean_Click" />
            <Button Content="转移显卡着色器缓存" Click="Shader_Click" />
            <Button Content="恢复着色器缓存原位置" Click="Restore_Click" />
        </StackPanel>
        <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="DimGray" />
    </Grid>
</Window>
